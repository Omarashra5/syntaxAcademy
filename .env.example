# GEMINI_API_KEY: Required if server-side Gemini AI features are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="http://localhost:3000"

# ADMIN_INITIAL_PASSWORD: Server-side secret for initial administrator login.
# Never expose this in frontend VITE_* variables. Rotate from Admin Settings after first login.
ADMIN_INITIAL_PASSWORD="syntaxomar@01012G.com"

# SESSION_SECRET: HMAC signing secret for HTTP-only admin session cookies (min 32 chars in production).
SESSION_SECRET="replace-with-a-strong-random-64-char-hex-secret"

# FIREBASE_SERVICE_ACCOUNT_KEY: Optional JSON string of Firebase Service Account credentials
# for server-side Firebase Admin SDK operations (used when deploying outside GCP ADC).
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Optional Frontend Firebase Config Overrides (defaults to firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
